.env*.local
.env

# Firebase config files
google-services.json
GoogleService-Info.plist

# Firebase admin service-account keys. Keep the key OUTSIDE the repo
# (GOOGLE_APPLICATION_CREDENTIALS, src/scripts/firebaseAdmin.ts refuses one
# inside it); these patterns are only a backstop.
*firebase-adminsdk*.json
service-account*.json
serviceAccount*.json

# typescript
*.tsbuildinfo


# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
eas.json

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*


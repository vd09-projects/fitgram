// Reconciled with the console 2026-10-26; this file is now the source. Deploy
// with `npx firebase-tools@13.35.1 deploy --only firestore:rules`; a deploy replaces the
// whole live ruleset, so a rule kept only in the console is lost.
//
// DEPLOY ORDER (TICKET-073): the plans rule below refuses any plan write without
// the right `rev`. Deploy it only once the app build that sends `rev` is on
// every phone; deployed first, it refuses every Save from older builds.
//
// Tested against the Firestore emulator: `npm run test:rules`
// (src/firestoreRules/firestoreRules.test.ts). Run it before every deploy.
//
// What it covers: everything under users/{uid} is private to that user, which is
// what the exercise-first collections need (sessions, exercise_sessions,
// exercise_stats). No collection-group queries are used, so no collection-group
// rules are required.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Plans (TICKET-073): a save must be made on the stored version, so a
      // device that saves an old version is refused, online or when its
      // queued write lands later. Firestore has no compare-and-set for
      // offline writes (a transaction needs the server), so we do it here.
      //
      // Each plan carries one `version` map: { rev, id, base }. What each part
      // is for, and why `rev` stays beside `id`, is in src/utils/planVersion.ts;
      // keep the two in step. In short: `version.base` = the stored
      // `version.id` is the safety check ("made on what the server holds");
      // `rev` + 1 keeps the counter the phones order copies by honest. A plan
      // with no `version` (saved before 073; no backfill, pre-launch) counts
      // as rev 0, id null.
      //
      // - create: rev 1 and an id. Chosen over also allowing no version: every
      //   writer of this build sends one.
      // - update: rev = stored + 1, base = stored id, and a new id (not the
      //   stored one). A missing `version` or field makes the read an error,
      //   which refuses the write. A stored version that is not a map with a
      //   number rev (only a hand edit could do it) does the same for every
      //   save of that plan until fixed in the console.
      // - delete: allowed, as before: the wipe scripts delete plans, and there
      //   is no Delete feature yet. The future Delete writes a `deleted: true`
      //   marker, which is an update and must pass this rule like any Save.
      // - read: as before.
      // Rejected: a transaction on Save (refuses every offline save); `rev`
      // alone (two devices' counters collide: PR #50 review, B1); `rev` only,
      // fixed on the phone (two client rules that must hold for good); three
      // top-level fields (one map says it is one thing); a stricter rule
      // beside the old catch-all, which does nothing because Firestore allows
      // a request if any matching rule does. So the catch-all below leaves
      // `workouts` out.
      match /workouts/{planId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.version.rev == 1
          && request.resource.data.version.id is string;
        allow update: if isOwner(userId)
          && request.resource.data.version.rev == resource.data.get(['version', 'rev'], 0) + 1
          && request.resource.data.version.base == resource.data.get(['version', 'id'], null)
          && request.resource.data.version.id != resource.data.get(['version', 'id'], null);

        // Anything under a plan (none exists): today's access, unchanged.
        // `{sub}` first: `{rest=**}` alone also matches zero segments, i.e.
        // the plan itself, and would allow every write the rule above refuses.
        match /{sub}/{rest=**} {
          allow read, write: if isOwner(userId);
        }
      }

      // Every other collection and everything under it (sessions,
      // exercise_sessions, exercise_stats, ...): today's access, unchanged.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId) && collection != 'workouts';
      }
    }

    // The exercise catalog (TICKET-042 stage 2): `meta` and `catalog`, read by
    // every signed-in phone, written only by src/scripts/uploadCatalog.ts with
    // admin credentials, which bypass these rules.
    match /exercise_catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

// Reconciled with the console 2026-10-26; this file is now the source. Deploy
// with `npx firebase-tools deploy --only firestore:rules`; a deploy replaces the
// whole live ruleset, so a rule kept only in the console is lost.
//
// DEPLOY ORDER (TICKET-073): the plans rule below refuses any plan write without
// the right `rev`. Deploy it only once the app build that sends `rev` is on
// every phone; deployed first, it refuses every Save from older builds.
//
// Tested against the Firestore emulator: `npm run test:rules`
// (src/firestoreRules/firestoreRules.test.ts). Run it before every deploy.
//
// What it covers: everything under users/{uid} is private to that user, which is
// what the exercise-first collections need (sessions, exercise_sessions,
// exercise_stats). No collection-group queries are used, so no collection-group
// rules are required.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Plans (TICKET-073 D6): a save must be based on the stored version.
      // Each plan carries `rev`, and a write must carry the stored `rev` + 1, so
      // a device that saves an old version is refused, online or when its
      // queued write lands later. A missing `rev` counts as 0 (plans saved
      // before 073; no backfill, pre-launch).
      //
      // - create: `rev` must be 1. Chosen over also allowing no `rev`: every
      //   writer of this build sends it, and a plan created without one by an
      //   older build would then be refused on its first update anyway.
      // - update: `rev` = stored `rev` + 1. A `rev` that is missing, not a
      //   number, skips a number or repeats the stored one is refused. A stored
      //   `rev` that is not a number (only a hand edit could do it) makes the
      //   sum an error, which refuses every save of that plan until fixed in
      //   the console.
      // - delete: allowed, as before: the wipe scripts delete plans, and there
      //   is no Delete feature yet. The future Delete writes a `deleted: true`
      //   marker, which is an update and must bump `rev` like any Save.
      // - read: as before.
      // Rejected: a transaction on Save (refuses every offline save); a
      // stricter rule beside the old catch-all, which does nothing because
      // Firestore allows a request if any matching rule does. So the catch-all
      // below leaves `workouts` out.
      match /workouts/{planId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.rev == 1;
        allow update: if isOwner(userId)
          && request.resource.data.rev == resource.data.get('rev', 0) + 1;

        // Anything under a plan (none exists): today's access, unchanged.
        // `{sub}` first: `{rest=**}` alone also matches zero segments, i.e.
        // the plan itself, and would allow every write the rule above refuses.
        match /{sub}/{rest=**} {
          allow read, write: if isOwner(userId);
        }
      }

      // Every other collection and everything under it (sessions,
      // exercise_sessions, exercise_stats, ...): today's access, unchanged.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId) && collection != 'workouts';
      }
    }

    // The exercise catalog (TICKET-042 stage 2): `meta` and `catalog`, read by
    // every signed-in phone, written only by src/scripts/uploadCatalog.ts with
    // admin credentials, which bypass these rules.
    match /exercise_catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

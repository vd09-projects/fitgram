// Reconciled with the console 2026-10-26; this file is now the source. Deploy
// with `npx firebase-tools deploy --only firestore:rules`; a deploy replaces the
// whole live ruleset, so a rule kept only in the console is lost.
//
// What it covers: everything under users/{uid} is private to that user, which is
// what the exercise-first collections need (sessions, exercise_sessions,
// exercise_stats). No collection-group queries are used, so no collection-group
// rules are required.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The exercise catalog (TICKET-042 stage 2): `meta` and `catalog`, read by
    // every signed-in phone, written only by src/scripts/uploadCatalog.ts with
    // admin credentials, which bypass these rules.
    match /exercise_catalog/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
